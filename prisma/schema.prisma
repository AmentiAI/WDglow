generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Admin {
  id                 String   @id @default(cuid())
  email              String   @unique
  passwordHash       String
  name               String
  mustChangePassword Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Settings {
  id           String @id @default("default")
  businessName String @default("WDGLOW")
  ownerName    String @default("")
  phone        String @default("")
  email        String @default("wdglow@gmail.com")
  street       String @default("")
  city         String @default("Westerly")
  state        String @default("RI")
  zip          String @default("02891")
  hours        String @default("Monday–Sunday, 7:00am–6:00pm")
  instagram    String @default("")
  facebook     String @default("")
  aboutNote    String @default("")
}

model Lead {
  id           String     @id @default(cuid())
  name         String
  email        String
  phone        String
  street       String     @default("")
  city         String
  state        String
  zip          String     @default("")
  propertyType String
  services     String
  timeline     String     @default("")
  message      String     @default("")
  status       String     @default("new")
  source       String     @default("website")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  customer     Customer?
  quotes       Quote[]
  jobs         Job[]
  notes        Note[]

  @@index([status])
  @@index([createdAt])
  @@index([email])
}

model Customer {
  id        String   @id @default(cuid())
  leadId    String?  @unique
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  name      String
  email     String
  phone     String
  street    String   @default("")
  city      String
  state     String
  zip       String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  quotes    Quote[]
  jobs      Job[]
  notes     Note[]

  @@index([city, state])
}

model Quote {
  id         String    @id @default(cuid())
  number     String    @unique
  leadId     String?
  lead       Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  title      String
  lineItems  Json
  subtotal   Int       @default(0)
  tax        Int       @default(0)
  total      Int       @default(0)
  status     String    @default("draft")
  validUntil DateTime?
  notes      String    @default("")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([status])
  @@index([createdAt])
}

model Job {
  id            String    @id @default(cuid())
  leadId        String?
  lead          Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  quoteId       String?
  title         String
  service       String
  status        String    @default("scheduled")
  paymentStatus String    @default("unpaid")
  street        String    @default("")
  city          String
  state         String
  zip           String    @default("")
  installDate   DateTime?
  takedownDate  DateTime?
  price         Int       @default(0)
  deposit       Int       @default(0)
  notes         String    @default("")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  notesLog      Note[]

  @@index([status])
  @@index([installDate])
  @@index([takedownDate])
  @@index([paymentStatus])
}

model Note {
  id         String    @id @default(cuid())
  body       String
  author     String    @default("Admin")
  leadId     String?
  lead       Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  jobId      String?
  job        Job?      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())

  @@index([leadId])
  @@index([customerId])
  @@index([jobId])
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  city      String
  state     String
  quote     String
  rating    Int      @default(5)
  service   String   @default("")
  featured  Boolean  @default(false)
  published Boolean  @default(false)
  createdAt DateTime @default(now())
}

model GalleryItem {
  id        String   @id @default(cuid())
  title     String
  location  String
  category  String
  imageUrl  String
  alt       String
  featured  Boolean  @default(false)
  published Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model Post {
  id              String    @id @default(cuid())
  slug            String    @unique
  title           String
  excerpt         String
  content         String
  metaTitle       String    @default("")
  metaDescription String    @default("")
  published       Boolean   @default(false)
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}
